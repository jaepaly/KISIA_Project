# 매일 새벽 글 데이터를 시딩 상태로 되돌린다. 심사 기간에 방문자가 지운 글·고친 문장이 쌓이지 않게.
# seed.py --reset 은 db 파일을 지우고 다시 만든다 → 켜져 있는 프로세스는 지워진 inode 를 계속 붙들고 있으므로 반드시 멈췄다 켠다.
[Unit]
Description=Veilo demo data reseed
After=veilo.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/srv/veilo/.env
Environment=PYTHONIOENCODING=utf-8 PYTHONPATH=/srv/veilo/app/src
ExecStart=/bin/systemctl stop veilo padopool
ExecStart=/bin/sh -c 'cd /srv/veilo/app && sudo -u veilo env PYTHONIOENCODING=utf-8 PYTHONPATH=/srv/veilo/app/src SNS_DB_PATH=$SNS_DB_PATH /srv/veilo/venv/bin/python apps/demo/seed.py --reset'
ExecStart=/bin/sh -c 'rm -rf /srv/veilo/data/visitors'
ExecStart=/bin/systemctl start padopool veilo
