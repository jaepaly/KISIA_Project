# /etc/systemd/system/veilo.service — Veilo 플랫폼 (심사위원이 보는 곳). nginx 가 80/443 → 127.0.0.1:3000
[Unit]
Description=Veilo (padopool demo platform)
After=network.target padopool.service
Wants=padopool.service

[Service]
User=veilo
WorkingDirectory=/srv/veilo/app
EnvironmentFile=/srv/veilo/.env
Environment=PYTHONIOENCODING=utf-8 PYTHONPATH=/srv/veilo/app/src:/srv/veilo/app/apps/demo
ExecStart=/srv/veilo/venv/bin/waitress-serve --listen=127.0.0.1:3000 --threads=8 wsgi_sns:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
