# /etc/systemd/system/padopool.service — 파도풀 API. 바깥에 안 연다 (Veilo 가 127.0.0.1:8000 으로 부른다)
[Unit]
Description=padopool API (demo)
After=network.target

[Service]
User=veilo
WorkingDirectory=/srv/veilo/app
EnvironmentFile=/srv/veilo/.env
Environment=PYTHONIOENCODING=utf-8 PYTHONPATH=/srv/veilo/app/src:/srv/veilo/app/apps/demo
ExecStart=/srv/veilo/venv/bin/waitress-serve --listen=127.0.0.1:8000 --threads=8 wsgi_pado:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
