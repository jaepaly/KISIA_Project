# /srv/veilo/.env — systemd EnvironmentFile. 서버에만 두고 저장소에 넣지 않는다. 값에 따옴표 없이.
PYTHONIOENCODING=utf-8
SNS_DB_PATH=/srv/veilo/data/sns.db
PADOPOOL_URL=http://127.0.0.1:8000
SNS_URL=http://127.0.0.1:3000
# 심사용은 문을 연다(비워 둠). 비공개 리허설 때만 값을 넣는다
DEMO_ACCESS_KEY=
DEMO_STATION_SCOPE=emd
# 방문자 사본을 몇 초 안 쓰면 지울지 (기본 6시간)
DEMO_VISITOR_TTL=21600
# 세션 쿠키 서명 키 — 방문자 사본을 가르는 값이라 서버마다 다르게 둔다
SNS_SECRET=
# 하이브리드 리라이트 — 협회 게이트웨이. 키는 로컬 .env 의 값을 그대로 옮긴다
DEMO_EXTERNAL_REWRITE=true
DEMO_EXTERNAL_MODEL=claude-haiku-4.5
ANTHROPIC_BASE_URL=https://monogpt.kr/api/monorouter/v1/anthropic
ANTHROPIC_API_KEY=
