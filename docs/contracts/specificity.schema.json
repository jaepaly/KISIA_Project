{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaepaly/KISIA_Project/docs/contracts/specificity.schema.json",
  "title": "특정성(k-익명성 근사) 입출력",
  "description": "로컬 특정성 계산 엔진의 요청 조건과 계산 결과 계약. k는 조건 조합으로 남는 추정 후보 모집단 크기이며, 산출 불가 시 0이 아닌 null을 사용한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "dict_version",
    "input",
    "output"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "description": "특정성 계산 엔진 버전. 예: c2-0.1.0"
    },
    "dict_version": {
      "type": "string",
      "minLength": 1,
      "description": "특정성 계산에 사용한 사전 버전. 예: geo-2026-07"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "output": {
      "$ref": "#/$defs/output"
    }
  },
  "$defs": {
    "axis": {
      "type": "string",
      "enum": [
        "location",
        "age",
        "sex",
        "occupation",
        "family",
        "commute",
        "income"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_ref",
        "conditions"
      ],
      "properties": {
        "user_ref": {
          "type": "string",
          "pattern": "^u_[0-9a-f]{8,}$",
          "description": "런타임 사용자를 가리키는 비식별 참조값. 원본 사용자 ID를 넣지 않는다."
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "kind",
        "resolution",
        "confidence",
        "source_post_ids"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "축 내부 조건 유형. 예: administrative_area, age_band, job_group"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "정규화된 조건값. 위치 조건은 geo_code와 함께 사용할 수 있다."
        },
        "geo_code": {
          "type": "string",
          "pattern": "^[0-9]{2,10}$",
          "description": "위치 조건의 정규화된 행정표준코드. 계층을 다 받으려고 2~10자리로 열어둔다 — 시도 2, 시군구 5, 읍면동 10. 정수로 파싱하면 앞자리 0이 죽으므로 문자열로 고정한다."
        },
        "resolution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "조건의 세분화 수준. 0이 가장 넓고 4가 가장 구체적이다."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "로컬 탐지기가 해당 조건을 추출한 신뢰도"
        },
        "source_post_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "해당 조건의 근거가 된 게시물 비식별 참조값 목록"
        }
      },
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "geo_code"
          ]
        }
      ],
      "allOf": [
        {
          "$comment": "age_band 는 인구통계 교차표를 조회하는 값이므로 표기가 고정되어야 한다. 교차표가 5년 단위(40-44 · 45-49)라 «40대» 같은 값이 들어오면 조회가 안 된다. 개방 구간은 100+ 하나뿐이다. 90+ 를 함께 허용하면 같은 연령이 두 값으로 조회돼 k 가 갈린다.",
          "if": {
            "properties": {
              "kind": {
                "const": "age_band"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "enum": [
                  "0-4", "5-9", "10-14", "15-19", "20-24", "25-29",
                  "30-34", "35-39", "40-44", "45-49", "50-54", "55-59",
                  "60-64", "65-69", "70-74", "75-79", "80-84", "85-89",
                  "90-94", "95-99", "100+"
                ]
}
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "k_level",
        "basis",
        "risk",
        "risk_by_axis",
        "floor_applied",
        "steps",
        "assumptions"
      ],
      "properties": {
        "k": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "description": "조건 조합에 따른 추정 후보 모집단 크기. 산출할 수 없으면 0이 아닌 null"
        },
                "k_union": {
          "type": "number",
          "minimum": 1,
          "description": "법정동 1:N 확장 시 후보 행정동 인구의 합"
        },
        "k_min": {
          "type": "number",
          "minimum": 1,
          "description": "법정동 1:N 확장 시 후보별 인구의 최솟값. k_level 판정 기준"
        },
        "codes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "description": "법정동 1:N 확장으로 얻은 행정동 geo_code 전체"
        },
        "k_level": {
          "type": "string",
          "enum": [
            "VERY_HIGH",
            "HIGH",
            "ACCEPTABLE",
            "UNKNOWN"
          ],
          "description": "k 판정 등급. k<=2는 VERY_HIGH, 2<k<5는 HIGH, k>=5는 ACCEPTABLE, k=null은 UNKNOWN.\n\n[경계값의 근거] 이 숫자는 우리 데이터 분포에서 나온 것이 아니라 개인정보위 «가명정보 처리 가이드라인»의 적정성 검토 절차에서 온다 — k<=2 개인 특정 가능 / 3~4 소수로 좁혀짐 / >=5 집단 내 익명. plan.md §13.1 이 정본이다.\n\n그래서 실측 k 분포가 예상과 달라도 이 경계는 안 움직인다. 분포가 이상하면 경계가 아니라 k 추정기(alpha·감쇠 계수·floor_applied)를 본다. 경계를 데이터로 맞추면 심사에서 «왜 k<=2 인가»에 답할 근거가 사라지고, W1 에 선언한 성공 기준(«위험도의 법적 정박»)도 함께 무너진다.\n\n한글 문구는 화면 표기이며 E 가 매핑한다. 코드 값은 영문 상수다."
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "전체 특정성 위험도 점수. k와 축별 기여도를 이용해 엔진이 산출한 0~100 값"
        },
        "risk_by_axis": {
          "$ref": "#/$defs/risk_by_axis"
        },
        "floor_applied": {
          "type": "boolean",
          "description": "추정 후보 수가 1 미만일 때 k=1 하한을 적용했는지 여부"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "초기 모집단부터 조건을 순차 적용한 계산 추적 정보"
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "독립성 가정, 감쇠계수 등 결과 해석에 필요한 계산 가정"
        }
      },
      "oneOf": [
        {
          "properties": {
            "k": {
              "type": "null"
            },
            "k_level": {
              "const": "UNKNOWN"
            }
          }
        },
        {
          "properties": {
            "k": {
              "type": "number",
              "minimum": 1,
              "maximum": 2
            },
            "k_level": {
              "const": "VERY_HIGH"
            }
          }
        },
        {
          "properties": {
            "k": {
              "type": "number",
              "exclusiveMinimum": 2,
              "exclusiveMaximum": 5
            },
            "k_level": {
              "const": "HIGH"
            }
          }
        },
        {
          "properties": {
            "k": {
              "type": "number",
              "minimum": 5
            },
            "k_level": {
              "const": "ACCEPTABLE"
            }
          }
        }
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "as_of"
      ],
      "properties": {
                "method": {
          "type": "string",
          "enum": [
            "direct",
            "legal_dong_expansion"
          ],
          "description": "지역을 직접 조회했는지 법정동 1:N 확장을 사용했는지 표시"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "실제 k 계산에 사용한 모집단 통계 출처"
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(?:-([0-2][0-9]|3[01]))?$",
          "description": "통계 기준 시점(YYYY-MM 또는 YYYY-MM-DD). 예: 2026-07"
        }
      }
    },
    "risk_by_axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/risk_score"
        },
        "age": {
          "$ref": "#/$defs/risk_score"
        },
        "sex": {
          "$ref": "#/$defs/risk_score"
        },
        "occupation": {
          "$ref": "#/$defs/risk_score"
        },
        "family": {
          "$ref": "#/$defs/risk_score"
        },
        "commute": {
          "$ref": "#/$defs/risk_score"
        },
        "income": {
          "$ref": "#/$defs/risk_score"
        }
      },
      "description": "입력에 포함된 축별 특정성 위험 기여도(0~100). 미사용 축은 생략 가능"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "condition",
        "n_after",
        "method"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "n_after": {
          "type": "number",
          "minimum": 0,
          "description": "해당 조건을 적용한 직후의 하한 적용 전 추정 후보 수"
        },
        "method": {
          "type": "string",
          "enum": [
            "population_lookup",
            "crosstab_lookup",
            "legal_dong_expansion_min",
            "ratio_damped"
          ]
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "통계 또는 사전에서 얻은 원래 조건 비율"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "q_damped": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "신뢰도와 감쇠를 적용해 실제 계산에 사용한 비율"
        }
      }
    }
  }
}
