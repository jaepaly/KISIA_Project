{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kopl/contracts/specificity.schema.json",
  "title": "특정성(k-익명성 근사) 입출력",
  "type": "object",
  "required": ["schema_version", "query", "result"],
  "additionalProperties": false,

  "properties": {
    "schema_version": {
      "const": "1.0"
    },

    "query": {
      "type": "object",
      "required": ["attributes"],
      "additionalProperties": false,

      "properties": {
        "attributes": {
          "type": "object",
          "description": "특정성 계산에 사용한 조건 조합. 확인된 속성만 포함한다.",
          "additionalProperties": false,

          "properties": {
            "region_code": {
              "type": "string",
              "pattern": "^[0-9]{2,10}$",
              "description": "행정구역 표준코드. 앞자리 0 보존을 위해 문자열로 전달한다."
            },

            "age_band": {
              "type": "string",
              "description": "특정성 계산에 사용한 연령 구간."
            },

            "sex": {
              "type": "string",
              "enum": ["M", "F"]
            }
          }
        }
      }
    },

    "result": {
      "type": "object",
      "required": ["k", "level", "basis"],
      "additionalProperties": false,

      "properties": {
        "k": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "조건 조합에 해당하는 추정 후보 모집단 크기. 산출할 수 없는 경우 null로 전달하며 0으로 대체하지 않는다."
        },

        "level": {
          "type": "string",
          "enum": [
            "VERY_HIGH",
            "HIGH",
            "ACCEPTABLE",
            "UNKNOWN"
          ],
          "description": "k와 함께 전달되는 특정성 등급. 매핑 규칙은 specificity에서 관리한다. 등급 경계값은 개인정보위 가명정보 처리 가이드라인의 적절성 검토 절차를 토대로 확정한다. k 산출이 불가능한 경우 UNKNOWN으로 전달하며 기존 위험등급으로 임의 변환하지 않는다."
        },

        "basis": {
          "type": "object",
          "required": ["source", "as_of"],
          "additionalProperties": false,

          "properties": {
            "source": {
              "type": "string",
              "description": "k 계산에 사용한 통계 또는 공공데이터 출처."
            },

            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "통계 기준월. YYYY-MM 형식."
            }
          }
        }
      }
    }
  }
}
