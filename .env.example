# =============================================================
#  환경변수 예시 — 이 파일은 커밋된다. 실제 키는 절대 넣지 않는다.
#  쓰는 법: cp .env.example .env  후 .env 에만 실제 값을 채운다.
#  .env 는 .gitignore가 막고 있고, pre-commit 훅이 한 번 더 막는다.
# =============================================================

# --- LLM (교사 라벨 · 평가 상한 · 생성) -----------------------
# ⚠️ 역할 분리 원칙 (plan.md §4):
#    ① 교사 라벨 · ③ 평가 상한 → 협회 지원 API
#    생성 모델은 교사와 반드시 다른 모델을 쓴다 (순환 편향 방지)
#    ② 런타임 2단에는 외부 API를 쓰지 않는다 — 로컬 Qwen3만
ANTHROPIC_API_KEY=
GENERATION_LLM_API_KEY=

# --- AWS (학습 인스턴스 · 크레딧) ------------------------------
# ⚠️ 루트 액세스키 금지. IAM 최소권한 + Budgets 알림 설정 후 발급
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# --- 로컬 모델 경로 -------------------------------------------
STAGE1_MODEL_PATH=./models/stage1-koelectra
STAGE2_MODEL_PATH=./models/stage2-qwen3-4b

# --- 가상 SNS 플랫폼 -------------------------------------------
SNS_DB_URL=sqlite:///./data/interim/sns.db
SNS_PORT=3000

# --- 분석 웹앱 -------------------------------------------------
ANALYZER_PORT=8000
# 외부 전송 0 원칙의 런타임 스위치. 기본값 유지할 것.
ALLOW_EXTERNAL_LLM=false
